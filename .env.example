# 把本文件复制为 .env，然后填写你的机器人信息
# 本文件只包含占位符，不能直接使用

# ===== QQ 官方机器人（必填） =====
# 方式 A：多机器人（推荐）。appId 和 clientSecret 来自 QQ 开放平台机器人详情页
QQBOTS_JSON=[{"accountId":"main","name":"我的机器人","appId":"在这里填AppID","clientSecret":"在这里填AppSecret"}]

# 方式 B：单机器人（与方式 A 二选一，方式 A 存在时优先）
# QQBOT_APP_ID=在这里填AppID
# QQBOT_CLIENT_SECRET=在这里填AppSecret

# ===== 白名单（强制） =====
# 机器人只响应这些 openid，多个用英文逗号分隔
# 留空时进入安全模式：机器人不执行任何任务，只回复引导信息并在 logs/bridge.log 登记 openid
# 正式使用前必须配置白名单并重启
ALLOWED_OPENIDS=

# ===== Codex =====
# Codex CLI 可执行文件。已加入 PATH 时不需要填
# CODEX_CLI_PATH=codex
# Codex 配置目录，默认取当前用户目录下的 .codex
# CODEX_HOME=
# 单次任务超时时间（毫秒）
CODEX_TIMEOUT_MS=300000

# ===== 文件与目录 =====
# 聊天记录保存目录，默认保存在当前用户目录下的 qq-bot-chat
# CHAT_LOG_ROOT=
# 聊天面板端口
PANEL_PORT=17890
# 可选：文件交换目录，留空时使用当前用户目录下的 iCloudDrive\Codex
# ICLOUD_DIR=
# 以下一般不需要修改
# WORK_DIR=
# INBOX_DIR=
